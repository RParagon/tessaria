# Copie para deploy/.env e preencha. NUNCA commite o .env.
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# Endereços de onde o jogo é aberto (separados por vírgula). Inclua https://localhost para o app Android.
CORS_ORIGINS=https://jogo.seu-dominio.com,https://seu-site.netlify.app,https://localhost
# Endereço público do servidor, usado no build da versão web
VITE_API_URL=https://api.seu-dominio.com
# Opcionais
GOOGLE_CLIENT_ID=
METRICS_TOKEN=
TRUST_PROXY=1
