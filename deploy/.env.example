# Copie para deploy/.env e preencha. NUNCA commite o .env.
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# Endereços de onde o jogo é aberto (separados por vírgula). Inclua https://localhost para o app Android.
CORS_ORIGINS=https://jogo.seu-dominio.com,https://seu-site.netlify.app,https://localhost
# Endereço público do servidor, usado no build da versão web
VITE_API_URL=https://api.seu-dominio.com
# Opcionais
GOOGLE_CLIENT_ID=
METRICS_TOKEN=
# Moderação (/admin/...): valor longo e aleatório
ADMIN_TOKEN=
TRUST_PROXY=1
# Mercado Pago (compra de Fios Dourados). O token é SEGREDO: só aqui no .env/painel, nunca no repositório.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Endereço público da API (o Mercado Pago chama PUBLIC_API_URL/payments/mp/webhook) e do site (volta do checkout)
PUBLIC_API_URL=https://api.seu-dominio.com
SITE_URL=https://jogo.seu-dominio.com
